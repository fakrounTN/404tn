# 404TN Platform Environment Configuration (Template)
# Copy to .env or .env.local and populate with your production values.

# ==============================================================================
# ENVIRONMENT MODE
# ==============================================================================
APP_ENV=production
LOG_LEVEL=INFO
ENABLE_DOCS=false

# ==============================================================================
# PUBLIC FRONTEND VARIABLES (Delivered to browser client JavaScript)
# ==============================================================================
# Base URL for evidence API
VITE_API_URL=https://api.404tn.com/api

# CARTO Basemaps raster tile access key
VITE_CARTO_API_KEY=CHANGE_ME_CARTO_KEY

# Public Site URL
VITE_SITE_URL=https://404tn.com

# ==============================================================================
# PRIVATE BACKEND VARIABLES (API & Collector internal use only)
# ==============================================================================
API_HOST=0.0.0.0
API_PORT=8000

# SQLite persistent database path (inside container)
DATABASE_PATH=/data/404tn.db

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=https://404tn.com,https://www.404tn.com

# Allowed Hosts for Host header validation
ALLOWED_HOSTS=api.404tn.com,localhost,127.0.0.1,api
